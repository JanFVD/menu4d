# PostgreSQL (ver docker-compose.yml)
DATABASE_URL="postgresql://menu4d:menu4d@localhost:5432/menu4d?schema=public"

# Puerto del servidor Next + Socket.io
PORT=3000

# URL pública que se codifica en los QR (usá la IP LAN para probar con el celular, ej. http://192.168.0.10:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PIN opcional para acceder al dashboard del local (vacío = sin PIN)
STAFF_PIN=""

